{
  "name": "packyapi-opencode-plugin",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin exposing multiple PackyAPI keys as independent providers with Responses-only models.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test tests/*.test.ts"
  },
  "keywords": [
    "packyapi",
    "opencode",
    "opencode-plugin",
    "openai-responses"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.7"
  },
  "devDependencies": {
    "@opencode/ai": "2.2.7",
    "@opencode/client": "2.2.7",
    "@opencode/plugin": "2.2.7",
    "@types/node": "^26.0.0",
    "effect": "4.1.0",
    "esbuild": "0.28.2",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fast-fuzzy": "1.12.0"
  }
}
